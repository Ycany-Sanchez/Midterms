<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>404 // Route Severed</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="min-h-[calc(100vh-8rem)] w-full flex items-center justify-center p-6">
                <div class="relative w-full max-w-md p-8 glass-card-accent shadow-2xl text-center anim-fade-up space-y-6 border border-rose-500/30">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400 text-2xl anim-float shadow-[0_0_20px_rgba(244,63,94,0.4)]">
                        <i class="fa-solid fa-satellite-dish"></i>
                    </div>
                    <div class="space-y-2">
                        <span class="inline-block px-3 py-1 text-xs font-mono font-semibold tracking-wider text-rose-300 uppercase bg-rose-500/20 border border-rose-500/40 rounded-full">
                            ERR: 404 // SUBNET SEVERED
                        </span>
                        <h1 class="text-2xl font-bold font-display text-white">Neural Route Severed</h1>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            The terminal sector you are attempting to probe does not exist in the mainframe. Return to the briefing gateway.
                        </p>
                    </div>
                    <a href="" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-mono text-sm font-bold text-white bg-gradient-to-r from-rose-600 via-red-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 shadow-lg shadow-rose-500/30 transition-all duration-200 card-lift">
                        <i class="fa-solid fa-house text-sm"></i>
                        <span>RETURN TO GATEWAY</span>
                    </a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
