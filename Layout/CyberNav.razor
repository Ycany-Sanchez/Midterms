@inject GameStateService GameState
@inject NavigationManager Navigation
@implements IDisposable

<header class="sticky top-0 z-50 w-full border-b border-white/[0.08] bg-[#0c0f16]">
    <div class="max-w-[1550px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Brand / Logo -->
        <NavLink href="" class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-lg bg-rose-500/15 border border-rose-500/40 flex items-center justify-center text-rose-400">
                <i class="fa-solid fa-vault text-base"></i>
            </div>
            <div>
                <span class="font-display font-bold text-lg tracking-tight text-white flex items-center gap-1.5">
                    VAULT<span class="text-rose-500">CODE</span>
                </span>
                <p class="text-[10px] text-slate-400 font-mono tracking-tight hidden sm:block">Code Breaker Minigame</p>
            </div>
        </NavLink>

        <!-- Navigation Sequence -->
        <nav class="flex items-center gap-1 sm:gap-2 font-mono text-xs">
            <NavLink href="" Match="NavLinkMatch.All" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 transition" ActiveClass="text-white bg-white/10 border border-white/10 font-bold">
                Home
            </NavLink>

            <NavLink href="login" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 transition" ActiveClass="text-white bg-white/10 border border-white/10 font-bold">
                Sign In
            </NavLink>

            <NavLink href="terminal" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 transition" ActiveClass="text-white bg-white/10 border border-white/10 font-bold">
                Terminal
            </NavLink>

            <NavLink href="signup" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 transition" ActiveClass="text-white bg-white/10 border border-white/10 font-bold">
                Recruit
            </NavLink>
        </nav>

        <!-- Right Side: Active Agent Clearance & Primary CTA -->
        <div class="flex items-center gap-3">
            <div class="hidden lg:flex items-center gap-2.5 px-3 py-1.5 rounded-lg bg-[#141924] border border-white/[0.08]">
                <div class="w-6 h-6 rounded-md bg-rose-500/20 text-rose-400 flex items-center justify-center text-xs">
                    <i class="fa-solid @GameState.CurrentAgent.AvatarIcon"></i>
                </div>
                <div class="text-left font-mono">
                    <p class="text-xs font-semibold text-white leading-none">@GameState.CurrentAgent.Codename</p>
                    <span class="text-[10px] text-slate-400">
                        @(GameState.CurrentAgent.ClearanceLevel == ClearanceLevel.Mastermind ? "Mastermind" : "Operative")
                    </span>
                </div>
            </div>

            <!-- Red CTA Button -->
            <NavLink href="terminal" class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 hover:bg-rose-500 text-white font-mono tracking-wider transition card-lift flex items-center gap-1.5">
                <i class="fa-solid fa-play text-[11px]"></i>
                <span class="hidden sm:inline">PLAY</span>
            </NavLink>
        </div>
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        GameState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        GameState.OnChange -= StateHasChanged;
    }
}
