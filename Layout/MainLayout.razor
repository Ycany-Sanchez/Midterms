@inherits LayoutComponentBase

<div class="relative min-h-screen text-slate-100 flex flex-col bg-[#090b10] selection:bg-rose-600 selection:text-white">
    <!-- Top Navigation Bar -->
    <CyberNav />

    <!-- Main Content View -->
    <main class="relative z-10 flex-1 flex flex-col">
        @Body
    </main>

    <!-- Global Clean Footer -->
    <footer class="relative z-10 border-t border-white/[0.08] bg-[#0c0f16] py-5 text-center text-xs text-slate-400 font-mono">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-slate-400">
                <i class="fa-solid fa-terminal text-rose-500"></i>
                <span class="tracking-wide">VaultCode — Midterms Application Development</span>
            </div>
            <div class="flex items-center gap-4 text-slate-400">
                <span class="text-slate-400">Blazor WebAssembly .NET 8.0</span>
                <span>•</span>
                <span class="text-emerald-400 flex items-center gap-1.5"><i class="fa-solid fa-circle text-[7px]"></i> System Online</span>
            </div>
        </div>
    </footer>
</div>
