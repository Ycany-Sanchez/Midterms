                                <i class="fa-solid fa-palette"></i> Spectral Feedback
                            </div>
                            <div class="space-y-1.5 text-slate-300">
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded flex-shrink-0 bg-emerald-500/30 border border-emerald-400 shadow-[0_0_6px_rgba(16,185,129,0.4)]"></span>
                                    <span><strong class="text-emerald-400">Emerald</strong> — Correct digit, correct slot</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded flex-shrink-0 bg-amber-500/30 border border-amber-400 shadow-[0_0_6px_rgba(245,158,11,0.4)]"></span>
                                    <span><strong class="text-amber-400">Amber</strong> — Digit exists, wrong position</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-4 h-4 rounded flex-shrink-0 bg-white/10 border border-white/20"></span>
                                    <span><strong class="text-slate-400">Slate</strong> — Digit not in passcode</span>
                                </div>
                            </div>
                        </div>

                        <!-- Core Rules -->
                        <div class="p-3.5 rounded-xl bg-black/50 border border-rose-500/20 space-y-2.5">
                            <div class="text-rose-300 font-bold uppercase tracking-wider flex items-center gap-1.5 text-[11px]">
