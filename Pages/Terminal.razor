                        <!-- Win / Lose Outcomes -->
                        <div class="p-3.5 rounded-xl bg-black/50 border border-rose-500/20 space-y-2.5">
                            <div class="text-rose-300 font-bold uppercase tracking-wider flex items-center gap-1.5 text-[11px]">
                                <i class="fa-solid fa-flag-checkered"></i> Outcome
                            </div>
                            <ul class="space-y-1.5 text-slate-300">
                                <li class="flex items-start gap-2">
                                    <i class="fa-solid fa-unlock-keyhole text-emerald-400 mt-0.5 flex-shrink-0 text-xs"></i>
                                    <span>Match all digits → <strong class="text-emerald-400">ACCESS GRANTED</strong></span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fa-solid fa-skull text-rose-400 mt-0.5 flex-shrink-0 text-xs"></i>
                                    <span>Time out or 6 fails → <strong class="text-rose-400">LOCKOUT</strong></span>
