                <!-- Top scanline accent bar -->
                <div class="h-1 w-full bg-gradient-to-r from-transparent via-rose-500 to-transparent opacity-80"></div>

                <div class="p-7 sm:p-9 space-y-6">
                    <!-- Header: Icon + Title -->
                    <div class="text-center space-y-3">
                        <div class="w-16 h-16 mx-auto rounded-2xl bg-rose-500/20 border border-rose-500/50 flex items-center justify-center text-rose-400 text-3xl shadow-[0_0_25px_rgba(244,63,94,0.5)] anim-float">
                            <i class="fa-solid fa-vault"></i>
