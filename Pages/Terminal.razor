@page "/terminal"
@inject GameStateService GameState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Vault Terminal — VaultCode</PageTitle>

<!-- Focusable wrapper to capture physical keyboard strokes -->
<div class="max-w-[1500px] mx-auto px-3 sm:px-5 lg:px-6 py-4 space-y-4 outline-none relative z-10" tabindex="0" @onkeydown="HandleKeyDown">
    
    <!-- TOP BREACH COMMAND BAR -->
    <header class="glass-card p-3 sm:p-4 relative overflow-hidden transition-all duration-300 @(secondsRemaining <= 10 && !GameState.ActiveGame.IsGameOver ? "anim-danger-pulse border-rose-500/80" : "border-rose-500/20")">
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-3">
            
            <!-- Left: Status & Mode Switcher -->
            <div class="flex flex-wrap items-center gap-2.5">
                @if (GameState.ActiveGame.IsSolved)
                {
                    <div class="px-3 py-1 rounded-xl bg-emerald-500/20 border border-emerald-400 text-emerald-300 font-mono text-xs font-bold flex items-center gap-2 shadow-[0_0_15px_rgba(16,185,129,0.5)]">
                        <i class="fa-solid fa-unlock-keyhole text-emerald-400"></i>
                        <span>VAULT UNLOCKED</span>
                    </div>
                }
                else if (GameState.ActiveGame.IsGameOver)
                {
                    <div class="px-3 py-1 rounded-xl bg-rose-500/25 border border-rose-500 text-rose-300 font-mono text-xs font-bold flex items-center gap-2">
                        <i class="fa-solid fa-lock text-rose-400"></i>
                        <span>LOCKOUT</span>
                    </div>
                }
                else
                {
                    <div class="px-2.5 py-1 rounded-xl bg-rose-500/15 border border-rose-500/40 text-rose-300 font-mono text-xs font-semibold flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full @(secondsRemaining <= 10 ? "bg-rose-500 animate-ping" : "bg-rose-400")"></span>
                        <span>@(secondsRemaining <= 10 ? "Time Critical" : "In Progress")</span>
                    </div>
                }

                <!-- Clearance Mode Selector -->
                <div class="flex items-center gap-1 bg-black/60 p-1 rounded-xl border border-rose-500/25 text-xs font-mono">
                    <button type="button" @onclick="() => SwitchClearance(ClearanceLevel.Operative)"
                            class="px-2.5 py-1 rounded-lg transition-all @(GameState.ActiveGame.ClearanceLevel == ClearanceLevel.Operative ? "bg-rose-500/25 text-rose-300 border border-rose-400/50 font-bold" : "text-slate-400 hover:text-white")">
                        Operative (4 Digits · 45s)
                    </button>
                    <button type="button" @onclick="() => SwitchClearance(ClearanceLevel.Mastermind)"
                            class="px-2.5 py-1 rounded-lg transition-all @(GameState.ActiveGame.ClearanceLevel == ClearanceLevel.Mastermind ? "bg-amber-500/25 text-amber-300 border border-amber-400/50 font-bold" : "text-slate-400 hover:text-white")">
                        Mastermind (5 Digits · 30s Hard)
                    </button>
                </div>
            </div>

            <!-- Center: Countdown Clock & Progress Bar -->
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <div class="text-[10px] font-mono tracking-wider uppercase text-slate-400">
                        @(secondsRemaining <= 10 && !GameState.ActiveGame.IsGameOver ? "Hurry" : "Time Remaining")
                    </div>
                    <div class="text-2xl sm:text-3xl font-mono font-extrabold tracking-tight @(secondsRemaining <= 10 && !GameState.ActiveGame.IsGameOver ? "text-rose-400" : "text-rose-300")">
                        00:@(secondsRemaining < 10 ? $"0{secondsRemaining}" : secondsRemaining.ToString())
                    </div>
                </div>

                <!-- Threat Bar -->
                <div class="w-32 sm:w-40 space-y-1">
                    <div class="flex justify-between text-[10px] font-mono">
                        <span class="text-slate-400">Elapsed:</span>
                        <span class="font-bold @(tracePercent >= 70 ? "text-rose-400" : tracePercent >= 40 ? "text-amber-400" : "text-rose-300")">
                            @tracePercent%
                        </span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-black/60 border border-rose-500/20 overflow-hidden">
                        <div class="h-full transition-all duration-700 @(tracePercent >= 70 ? "bg-gradient-to-r from-amber-500 to-rose-600" : "bg-gradient-to-r from-red-600 to-rose-500")"
                             style="width: @(tracePercent)%;"></div>
                    </div>
                </div>
            </div>

            <!-- Right: Controls -->
            <div class="flex items-center gap-2">
                @if (penaltyFlash)
                {
                    <span class="px-2 py-1 rounded bg-rose-500 text-white font-mono font-extrabold text-[11px] animate-bounce">
                        -3s Penalty
                    </span>
                }

                <!-- Audio SFX Toggle -->
                <button type="button" @onclick="ToggleAudio"
                        class="px-2.5 py-1.5 rounded-xl border transition-all text-xs font-mono flex items-center gap-1.5 @(audioEnabled ? "bg-rose-500/20 border-rose-500/40 text-rose-300" : "bg-white/5 border-white/10 text-slate-500")"
                        title="Toggle Sound Effects">
                    <i class="fa-solid @(audioEnabled ? "fa-volume-high" : "fa-volume-xmark")"></i>
                    <span class="hidden sm:inline">@(audioEnabled ? "Sound On" : "Muted")</span>
                </button>

                <!-- Reboot Button -->
                <button type="button" @onclick="() => StartFreshVault()"
                        class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-rose-600 to-red-700 hover:from-rose-500 hover:to-red-600 text-white font-mono text-xs font-bold transition shadow-[0_0_15px_rgba(244,63,94,0.35)] card-lift flex items-center gap-1.5">
                    <i class="fa-solid fa-arrows-rotate"></i>
                    <span>New Game</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN COCKPIT: TWO-COLUMN TACTICAL DECK -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
        
        <!-- LEFT 7 COLS: DECRYPTION CORE (Matrix & Keypad) -->
        <div class="lg:col-span-7 space-y-4">
            <div class="glass-card-accent p-4 sm:p-5 space-y-4 relative overflow-hidden border-rose-500/25 @(isShaking ? "anim-shake border-rose-500/80" : "")">
                
                <!-- Matrix Header Bar -->
                <div class="flex items-center justify-between border-b border-rose-500/20 pb-2.5 text-xs font-mono">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-table-cells text-rose-400"></i>
                        <span class="text-white font-bold tracking-wider">Vault Code Matrix</span>
                    </div>

                    <!-- Attempts Cycle Tracker with 6 visual pips -->
                    <div class="flex items-center gap-2">
                        <span class="text-slate-400 text-[11px]">Attempt:</span>
                        <span class="font-bold text-white px-2 py-0.5 rounded bg-white/5 border border-rose-500/20">
                            @(Math.Min(GameState.ActiveGame.Attempts.Count + 1, GameState.ActiveGame.MaxAttempts)) / @GameState.ActiveGame.MaxAttempts
                        </span>
                        <div class="flex items-center gap-1">
                            @for (int p = 0; p < GameState.ActiveGame.MaxAttempts; p++)
                            {
                                var isUsed = p < GameState.ActiveGame.Attempts.Count;
                                var isCurrent = p == GameState.ActiveGame.Attempts.Count && !GameState.ActiveGame.IsGameOver;
                                <span class="w-2.5 h-2.5 rounded-full border transition-all duration-300 @(isUsed ? "bg-rose-500 border-rose-400" : isCurrent ? "bg-amber-400 border-amber-300" : "bg-black/60 border-rose-500/30")"></span>
                            }
                        </div>
                    </div>
                </div>

                <!-- 6-ROW VAULT MATRIX (With Wordle-style 3D flip animation) -->
                <div class="flex flex-col items-center space-y-2 py-1">
                    @for (int rowIndex = 0; rowIndex < GameState.ActiveGame.MaxAttempts; rowIndex++)
                    {
                        var isEvaluatedRow = rowIndex < GameState.ActiveGame.Attempts.Count;
                        var isActiveRow = rowIndex == GameState.ActiveGame.Attempts.Count && !GameState.ActiveGame.IsGameOver;
                        var attempt = isEvaluatedRow ? GameState.ActiveGame.Attempts[rowIndex] : null;
                        var isLatestEvaluated = rowIndex == GameState.ActiveGame.Attempts.Count - 1;

                        <div class="flex items-center gap-2 sm:gap-3">
                            <!-- Clean Row Number Tag -->
                            <span class="w-8 font-mono text-xs font-bold select-none text-right @(isActiveRow ? "text-rose-400" : isEvaluatedRow ? "text-slate-400" : "text-rose-950")">
                                0@(rowIndex + 1)
                            </span>

                            <!-- Digit Tiles for this Row -->
                            @for (int colIndex = 0; colIndex < GameState.ActiveGame.CodeLength; colIndex++)
                            {
                                if (isEvaluatedRow && attempt != null)
                                {
                                    var digitChar = attempt.GuessString.Length > colIndex ? attempt.GuessString[colIndex] : ' ';
                                    var status = attempt.Statuses.Count > colIndex ? attempt.Statuses[colIndex] : DigitStatus.Wrong;
                                    var tileClass = status switch
                                    {
                                        DigitStatus.Correct => "tile-correct",
                                        DigitStatus.Misplaced => "tile-misplaced",
                                        _ => "tile-wrong"
                                    };
                                    var flipClass = isLatestEvaluated ? $"anim-tile-flip delay-{colIndex * 100}" : "";

                                    <div class="tile-base @tileClass @flipClass font-mono">
                                        @digitChar
                                    </div>
                                }
                                else if (isActiveRow)
                                {
                                    var hasChar = currentInput.Length > colIndex;
                                    var digitChar = hasChar ? currentInput[colIndex] : ' ';
                                    var isNextTarget = currentInput.Length == colIndex;

                                    <div class="tile-base @(hasChar ? "tile-typing anim-tile-pop" : isNextTarget ? "tile-empty border-rose-500/50 animate-pulse" : "tile-empty") font-mono">
                                        @digitChar
                                    </div>
                                }
                                else
                                {
                                    <div class="tile-base tile-empty font-mono">
                                        &nbsp;
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- Spectral Feedback Legend Bar -->
                <div class="flex items-center justify-center gap-4 sm:gap-6 pt-2 border-t border-rose-500/15 text-[11px] font-mono text-slate-400">
                    <span class="flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded bg-emerald-500/30 border border-emerald-400 text-emerald-300 inline-block"></span>
                        <strong class="text-emerald-400">Correct Slot</strong>
                    </span>
                    <span class="flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded bg-amber-500/30 border border-amber-400 text-amber-300 inline-block"></span>
                        <strong class="text-amber-400">Misplaced</strong>
                    </span>
                    <span class="flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded bg-white/5 border border-white/20 text-slate-400 inline-block"></span>
                        <span>Wrong Digit</span>
                    </span>
                </div>

                <!-- Feedback Toast -->
                @if (!string.IsNullOrEmpty(statusFeedback))
                {
                    <div class="p-2 rounded-xl bg-rose-500/15 border border-rose-500/40 text-rose-300 text-xs font-mono text-center flex items-center justify-center gap-2 anim-fade-up">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@statusFeedback</span>
                    </div>
                }

                <!-- INTEGRATED KEYPAD -->
                <div class="pt-2 border-t border-rose-500/20 space-y-2.5">
                    <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 px-1">
                        <span><i class="fa-solid fa-keyboard mr-1.5 text-rose-400"></i>Keypad</span>
                        <span class="text-slate-500">Keyboard shortcuts: [0-9], [Del], [Enter]</span>
                    </div>

                    <div class="grid grid-cols-3 gap-2 sm:gap-2.5 max-w-sm mx-auto">
                        @for (int num = 1; num <= 9; num++)
                        {
                            var digit = num.ToString()[0];
                            var intelClass = GetKeypadIntelClass(digit);
                            <button type="button" @onclick="() => InputDigit(digit)" disabled="@GameState.ActiveGame.IsGameOver"
                                    class="keypad-btn h-11 sm:h-12 rounded-xl border text-base sm:text-lg font-bold font-mono flex items-center justify-center card-lift disabled:opacity-40 @intelClass">
                                @digit
                            </button>
                        }

                        <!-- Backspace / Delete -->
                        <button type="button" @onclick="DeleteDigit" disabled="@(GameState.ActiveGame.IsGameOver || currentInput.Length == 0)"
                                class="keypad-btn h-11 sm:h-12 rounded-xl bg-rose-950/40 hover:bg-rose-900/40 active:bg-rose-800/40 border border-rose-500/40 text-rose-300 font-mono text-xs sm:text-sm font-bold flex items-center justify-center gap-1.5 card-lift disabled:opacity-40"
                                title="Delete digit (Backspace)">
                            <i class="fa-solid fa-delete-left"></i>
                            <span>DEL</span>
                        </button>

                        <!-- Digit 0 -->
                        @{
                            var zeroIntelClass = GetKeypadIntelClass('0');
                        }
                        <button type="button" @onclick="() => InputDigit('0')" disabled="@GameState.ActiveGame.IsGameOver"
                                class="keypad-btn h-11 sm:h-12 rounded-xl border text-base sm:text-lg font-bold font-mono flex items-center justify-center card-lift disabled:opacity-40 @zeroIntelClass">
                            0
                        </button>

                        <!-- Execute Breach -->
                        <button type="button" @onclick="SubmitCurrentGuess" disabled="@(GameState.ActiveGame.IsGameOver || currentInput.Length != GameState.ActiveGame.CodeLength)"
                                class="keypad-btn h-11 sm:h-12 rounded-xl bg-gradient-to-r from-rose-600 via-red-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white font-mono text-xs sm:text-sm font-extrabold flex items-center justify-center gap-1.5 shadow-[0_0_15px_rgba(244,63,94,0.4)] card-lift disabled:opacity-40 disabled:pointer-events-none"
                                title="Submit Guess (Enter)">
                            <i class="fa-solid fa-arrow-turn-down fa-rotate-90"></i>
                            <span>ENTER</span>
                        </button>
                    </div>

                    <!-- REAL-TIME DIGIT TRACKING STRIP -->
                    <div class="p-2 rounded-xl bg-black/60 border border-rose-500/15 flex items-center justify-between text-[10px] font-mono">
                        <span class="text-slate-400 font-bold uppercase tracking-wider flex items-center gap-1">
                            <i class="fa-solid fa-barcode text-rose-400"></i> Tested Digits:
                        </span>
                        <div class="flex items-center gap-1 sm:gap-1.5">
                            @for (char d = '0'; d <= '9'; d++)
                            {
                                var currentDigit = d;
                                var intel = GetDigitIntel(currentDigit);
                                var badgeClass = intel switch
                                {
                                    DigitIntelStatus.Correct => "bg-emerald-500/25 text-emerald-300 border-emerald-500/50 font-extrabold",
                                    DigitIntelStatus.Misplaced => "bg-amber-500/25 text-amber-300 border-amber-500/50 font-extrabold",
                                    DigitIntelStatus.Eliminated => "bg-white/5 text-slate-600 border-white/5 line-through opacity-40",
                                    _ => "bg-black/50 text-slate-400 border-white/10"
                                };

                                <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-md border flex items-center justify-center text-[10px] font-mono @badgeClass">
                                    @currentDigit
                                </span>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- RIGHT 5 COLS: CLEAN GAME STATS & DOSSIER -->
        <div class="lg:col-span-5 space-y-4">
            
            <!-- CLEAN RULES & ROUND SUMMARY CARD -->
            <div class="glass-card p-4 sm:p-5 space-y-3 border-rose-500/25">
                <div class="flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-300 font-bold uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-info text-rose-400"></i> Game Rules
                    </span>
                    <span class="text-[10px] text-slate-400 font-mono">
                        6 Attempts Max
                    </span>
                </div>

                <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">
                    <div class="p-2.5 rounded-lg bg-black/60 border border-rose-500/20">
                        <span class="text-slate-500 block text-[10px]">TIME PER RUN</span>
                        <strong class="text-base font-bold text-white">
                            @(GameState.ActiveGame.ClearanceLevel == ClearanceLevel.Mastermind ? "30s (Hard)" : "45s (Normal)")
                        </strong>
                    </div>
                    <div class="p-2.5 rounded-lg bg-black/60 border border-rose-500/20">
                        <span class="text-slate-500 block text-[10px]">WRONG GUESS PENALTY</span>
                        <strong class="text-base font-bold text-amber-400">-3s per guess</strong>
                    </div>
                </div>

                <div class="p-2.5 rounded-lg bg-black/60 border border-rose-500/15 text-[11px] font-mono text-slate-300 space-y-1">
                    <div class="flex items-center gap-1.5 text-emerald-400">
                        <i class="fa-solid fa-check text-[10px]"></i>
                        <span>Green = right digit in right slot</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-amber-400">
                        <i class="fa-solid fa-rotate text-[10px]"></i>
                        <span>Amber = right digit, wrong slot</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-slate-400">
                        <i class="fa-solid fa-xmark text-[10px]"></i>
                        <span>Dark = digit not in code</span>
                    </div>
                </div>
            </div>

            <!-- AGENT DOSSIER & STATS CARD -->
            <div class="glass-card-accent p-4 sm:p-5 space-y-3.5 border-rose-500/25">
                <div class="flex items-center justify-between border-b border-rose-500/20 pb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400 text-base">
                            <i class="fa-solid @GameState.CurrentAgent.AvatarIcon"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="font-display font-bold text-white text-sm sm:text-base">@GameState.CurrentAgent.Codename</h3>
                                <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/40">
                                    @GameState.CurrentAgent.Role
                                </span>
                            </div>
                            <p class="text-[10px] font-mono text-slate-400">@GameState.CurrentAgent.FullName</p>
                        </div>
                    </div>

                    <!-- Dynamic Clearance Rank Badge -->
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded border flex items-center gap-1.5 font-bold @GameState.CurrentAgent.RankBadgeColor">
                        <i class="fa-solid @GameState.CurrentAgent.RankIcon"></i>
                        <span>@GameState.CurrentAgent.ClearanceRank</span>
                    </span>
                </div>

                <!-- Next Rank Progress Subtext -->
                <div class="text-[10px] font-mono text-slate-400 flex items-center justify-between px-1">
                    <span>Rank Progress:</span>
                    <span class="text-rose-400 font-bold">@GameState.CurrentAgent.NextRankRequirement</span>
                </div>

                <!-- 4 Quick Stats -->
                <div class="grid grid-cols-2 gap-2 font-mono text-center">
                    <div class="p-2 rounded-xl bg-black/60 border border-rose-500/15">
                        <span class="text-[9px] uppercase text-slate-400 block">Wins</span>
                        <div class="text-lg font-bold text-emerald-400">@GameState.CurrentAgent.TotalBreaches</div>
                    </div>

                    <div class="p-2 rounded-xl bg-black/60 border border-rose-500/15">
                        <span class="text-[9px] uppercase text-slate-400 block">Personal Best</span>
                        <div class="text-lg font-bold text-amber-400 flex items-center justify-center gap-1">
                            <span>@GameState.CurrentAgent.BestScore</span>
                            <span class="text-[10px] text-amber-500 font-normal">pts</span>
                        </div>
                    </div>

                    <div class="p-2 rounded-xl bg-black/60 border border-rose-500/15">
                        <span class="text-[9px] uppercase text-slate-400 block">Win Streak</span>
                        <div class="text-lg font-bold text-rose-400 flex items-center justify-center gap-1">
                            <span>@GameState.CurrentAgent.WinStreak</span>
                            <i class="fa-solid fa-fire text-amber-400 text-xs"></i>
                        </div>
                    </div>

                    <div class="p-2 rounded-xl bg-black/60 border border-rose-500/15">
                        <span class="text-[9px] uppercase text-slate-400 block">Avg Attempts / Win</span>
                        <div class="text-lg font-bold text-white">@(GameState.AverageAttemptsPerWin > 0 ? $"{GameState.AverageAttemptsPerWin} cyc" : "-")</div>
                    </div>
                </div>

                <!-- Last 5 Heists Sparkline Strip -->
                <div class="p-2 rounded-xl bg-black/60 border border-rose-500/15 flex items-center justify-between text-xs font-mono">
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider font-bold">Recent 5 Form:</span>
                    <div class="flex items-center gap-1.5">
                        @foreach (var heist in GameState.LastFiveHeists.Reverse())
                        {
                            <span class="w-5 h-5 rounded-md flex items-center justify-center text-[10px] font-bold border @(heist.Won ? "bg-emerald-500/20 text-emerald-400 border-emerald-500/50" : "bg-rose-500/20 text-rose-400 border-rose-500/50")"
                                  title="@(heist.Won ? $"Cracked in {heist.AttemptsUsed} cycles (+{heist.Score} pts)" : "Lockout")">
                                @(heist.Won ? "W" : "L")
                            </span>
                        }
                    </div>
                </div>

                <!-- Recent Activity Feed -->
                <div class="space-y-1.5 pt-1">
                    <div class="flex items-center justify-between text-xs font-mono text-slate-300">
                        <span class="font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-clock-rotate-left text-rose-400"></i> Recent Games
                        </span>
                        <span class="text-[10px] text-slate-500">History</span>
                    </div>

                    <div class="space-y-1 max-h-36 overflow-y-auto pr-1">
                        @if (GameState.RecentHeists.Count == 0)
                        {
                            <div class="p-2.5 rounded-lg bg-black/40 text-center text-[10px] text-slate-500 font-mono">
                                No prior games recorded yet.
                            </div>
                        }
                        else
                        {
                            @foreach (var heist in GameState.RecentHeists.Take(4))
                            {
                                <div class="p-1.5 rounded-lg bg-black/60 border border-rose-500/15 flex items-center justify-between text-[10px] font-mono">
                                    <div class="flex items-center gap-1.5">
                                        @if (heist.Won)
                                        {
                                            <span class="w-4 h-4 rounded bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-[9px]">
                                                <i class="fa-solid fa-check"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="w-4 h-4 rounded bg-rose-500/20 text-rose-400 flex items-center justify-center text-[9px]">
                                                <i class="fa-solid fa-xmark"></i>
                                            </span>
                                        }
                                        <span class="text-white font-semibold">@(heist.Won ? "Cracked" : "Lockout")</span>
                                        <span class="text-slate-500">[@heist.SecretCode]</span>
                                    </div>
                                    <div class="text-right text-slate-400 flex items-center gap-2">
                                        @if (heist.Won && heist.Score > 0)
                                        {
                                            <span class="text-amber-400 font-bold">+@heist.Score</span>
                                        }
                                        <span>@heist.AttemptsUsed/6 attempts</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- GAME OVER MODAL -->
    @if (GameState.ActiveGame.IsGameOver)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md anim-fade-up">
            <div class="w-full max-w-md glass-card-accent p-6 sm:p-7 text-center space-y-5 border-2 @(GameState.ActiveGame.IsSolved ? "border-emerald-500/70 shadow-[0_0_40px_rgba(16,185,129,0.4)]" : "border-rose-500/70 shadow-[0_0_40px_rgba(244,63,94,0.5)]")">
                
                <!-- Status Icon -->
                <div class="w-16 h-16 mx-auto rounded-2xl flex items-center justify-center text-3xl @(GameState.ActiveGame.IsSolved ? "bg-emerald-500/20 text-emerald-300 border border-emerald-500/40" : "bg-rose-500/20 text-rose-300 border border-rose-500/40") anim-float">
                    @if (GameState.ActiveGame.IsSolved)
                    {
                        <i class="fa-solid fa-unlock-keyhole"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-lock"></i>
                    }
                </div>

                <!-- Title & Descriptive Verdict -->
                <div class="space-y-1.5">
                    <h2 class="text-2xl sm:text-3xl font-extrabold font-display @(GameState.ActiveGame.IsSolved ? "text-emerald-300" : "text-rose-400")">
                        @(GameState.ActiveGame.IsSolved ? "ACCESS GRANTED" : "LOCKOUT")
                    </h2>
                    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                        @if (GameState.ActiveGame.IsSolved)
                        {
                            <span>Vault cracked in <strong>@GameState.ActiveGame.Attempts.Count attempt(s)</strong> with <strong>@secondsRemaining seconds</strong> remaining!</span>
                        }
                        else
                        {
                            <span>Time ran out or 6 attempts reached before code deduction was achieved.</span>
                        }
                    </p>
                </div>

                <!-- Score Award Box (If Won) -->
                @if (GameState.ActiveGame.IsSolved)
                {
                    var latestRecord = GameState.RecentHeists.FirstOrDefault();
                    var scoreEarned = latestRecord?.Score ?? 0;
                    var isNewBest = scoreEarned >= GameState.CurrentAgent.BestScore && scoreEarned > 0;

                    <div class="p-3.5 rounded-xl bg-emerald-950/40 border border-emerald-500/30 flex items-center justify-between text-xs font-mono">
                        <div class="text-left">
                            <span class="text-slate-400 block text-[10px]">SCORE AWARDED</span>
                            <strong class="text-xl font-bold text-emerald-300">+@scoreEarned pts</strong>
                        </div>
                        @if (isNewBest)
                        {
                            <span class="px-2 py-1 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold text-[10px]">
                                <i class="fa-solid fa-trophy mr-1"></i>New Personal Best
                            </span>
                        }
                    </div>
                }

                <!-- Passcode Reveal Box -->
                <div class="p-3 rounded-xl bg-black/80 border border-rose-500/20 space-y-1">
                    <span class="text-[10px] font-mono uppercase tracking-widest text-slate-400">Vault Passcode Was:</span>
                    <div class="text-2xl sm:text-3xl font-mono font-extrabold tracking-widest text-rose-300">
                        @GameState.ActiveGame.RevealedCode
                    </div>
                </div>

                <!-- Flow CTA Buttons -->
                <div class="space-y-2.5">
                    <a href="signup"
                       class="w-full py-3.5 rounded-xl font-mono text-sm font-bold bg-gradient-to-r from-rose-600 via-red-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white shadow-[0_0_20px_rgba(244,63,94,0.45)] transition card-lift flex items-center justify-center gap-2">
                        <i class="fa-solid fa-user-plus"></i>
                        <span>Register Agent Profile</span>
                    </a>

                    <button type="button" @onclick="() => StartFreshVault()"
                            class="w-full py-2.5 rounded-xl font-mono text-xs font-semibold bg-white/5 hover:bg-white/10 border border-rose-500/25 text-slate-200 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-arrows-rotate text-rose-400"></i>
                        <span>Play Again</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ONE-TIME HOW TO PLAY MODAL -->
    @if (showBriefing)
    {
        <div class="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/90 backdrop-blur-md anim-fade-up">
            <div class="relative w-full max-w-lg glass-card-accent border border-rose-500/40 shadow-2xl overflow-hidden">
                <div class="p-6 sm:p-8 space-y-5">
                    <!-- Header -->
                    <div class="text-center space-y-2">
                        <div class="w-14 h-14 mx-auto rounded-2xl bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400 text-2xl anim-float">
                            <i class="fa-solid fa-vault"></i>
                        </div>
                        <div>
                            <span class="text-[10px] font-mono tracking-widest text-rose-400 uppercase">Quick Guide</span>
                            <h2 class="text-2xl font-bold font-display text-white mt-1">
                                How to Crack the Vault
                            </h2>
                        </div>
                    </div>

                    <!-- Instruction Cards: 2x2 Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
                        <!-- Colors -->
                        <div class="p-3 rounded-xl bg-black/50 border border-rose-500/20 space-y-2">
                            <div class="text-rose-300 font-bold uppercase tracking-wider text-[11px]">
                                Color Feedback
                            </div>
                            <div class="space-y-1.5 text-slate-300">
                                <div class="flex items-center gap-2">
                                    <span class="w-3.5 h-3.5 rounded flex-shrink-0 bg-emerald-500/30 border border-emerald-400"></span>
                                    <span><strong class="text-emerald-400">Green</strong>: Right digit, right slot</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-3.5 h-3.5 rounded flex-shrink-0 bg-amber-500/30 border border-amber-400"></span>
                                    <span><strong class="text-amber-400">Amber</strong>: In code, wrong slot</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="w-3.5 h-3.5 rounded flex-shrink-0 bg-white/10 border border-white/20"></span>
                                    <span><strong class="text-slate-400">Slate</strong>: Not in code</span>
                                </div>
                            </div>
                        </div>

                        <!-- Rules -->
                        <div class="p-3 rounded-xl bg-black/50 border border-rose-500/20 space-y-2">
                            <div class="text-rose-300 font-bold uppercase tracking-wider text-[11px]">
                                Rules
                            </div>
                            <ul class="space-y-1 text-slate-300">
                                <li>• <strong>6 attempts</strong> to find the passcode</li>
                                <li>• <strong>45s</strong> timer (Operative) / <strong>30s</strong> (Mastermind)</li>
                                <li>• <strong class="text-rose-400">-3s penalty</strong> for each wrong guess</li>
                            </ul>
                        </div>

                        <!-- Controls -->
                        <div class="p-3 rounded-xl bg-black/50 border border-rose-500/20 space-y-2">
                            <div class="text-rose-300 font-bold uppercase tracking-wider text-[11px]">
                                Controls
                            </div>
                            <ul class="space-y-1 text-slate-300">
                                <li>• Click the on-screen keypad, or type <kbd class="px-1 py-0.5 rounded bg-white/10 text-white text-[10px]">0-9</kbd></li>
                                <li>• Press <kbd class="px-1 py-0.5 rounded bg-white/10 text-white text-[10px]">Backspace</kbd> to delete</li>
                                <li>• Press <kbd class="px-1 py-0.5 rounded bg-white/10 text-white text-[10px]">Enter</kbd> to submit</li>
                            </ul>
                        </div>

                        <!-- Goal -->
                        <div class="p-3 rounded-xl bg-black/50 border border-rose-500/20 space-y-2">
                            <div class="text-rose-300 font-bold uppercase tracking-wider text-[11px]">
                                Objective
                            </div>
                            <ul class="space-y-1 text-slate-300">
                                <li>• Deduce all digits before the timer runs out</li>
                                <li>• Unused time & attempts give higher scores</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Pro Tip Banner -->
                    <div class="flex items-start gap-2.5 p-3 rounded-xl bg-amber-500/10 border border-amber-500/25 text-xs font-mono text-amber-300">
                        <i class="fa-solid fa-lightbulb text-amber-400 flex-shrink-0 mt-0.5"></i>
                        <span>Tip: Start with distinct digits like <strong>1 2 5 8</strong> to quickly discover which numbers are in the secret code.</span>
                    </div>

                    <!-- Dismiss Button -->
                    <button type="button" @onclick="DismissBriefing"
                            class="w-full py-3.5 rounded-xl font-mono text-sm font-bold bg-gradient-to-r from-rose-600 via-red-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white shadow-lg transition-all duration-200 card-lift flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check"></i>
                        <span>Got It, Start Playing</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string currentInput = "";
    private string statusFeedback = "";
    private int initialTime => GameState.ActiveGame.ClearanceLevel == ClearanceLevel.Mastermind ? 30 : 45;
    private int secondsRemaining = 45;
    private int tracePercent => (int)Math.Clamp(Math.Round((1.0 - (double)secondsRemaining / initialTime) * 100), 0, 100);
    private bool audioEnabled = true;
    private bool isShaking = false;
    private bool penaltyFlash = false;
    private CancellationTokenSource? cts;

    private bool showBriefing = false;
    private const string BRIEFING_KEY = "vaultcode_briefing_seen";

    private enum DigitIntelStatus { Untested, Correct, Misplaced, Eliminated }

    protected override void OnInitialized()
    {
        GameState.OnChange += HandleGameStateChange;
        ResetTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var seen = await JS.InvokeAsync<string?>("window.localStorage.getItem", BRIEFING_KEY);
                if (string.IsNullOrEmpty(seen))
                {
                    showBriefing = true;
                    cts?.Cancel();
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task DismissBriefing()
    {
        try
        {
            await JS.InvokeVoidAsync("window.localStorage.setItem", BRIEFING_KEY, "1");
        }
        catch { }

        showBriefing = false;
        ResetTimer();
        StateHasChanged();
    }

    private void HandleGameStateChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ResetTimer()
    {
        cts?.Cancel();
        cts = new CancellationTokenSource();
        secondsRemaining = initialTime;
        penaltyFlash = false;
        _ = StartTimerLoop(cts.Token);
    }

    private async Task StartTimerLoop(CancellationToken token)
    {
        using var periodicTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (!token.IsCancellationRequested && await periodicTimer.WaitForNextTickAsync(token))
        {
            if (GameState.ActiveGame.IsGameOver)
            {
                break;
            }

            if (secondsRemaining > 0)
            {
                secondsRemaining--;

                if (secondsRemaining <= 10 && secondsRemaining > 0 && audioEnabled)
                {
                    _ = JS.InvokeVoidAsync("CyberAudio.playWarningTick");
                }

                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await InvokeAsync(async () =>
                {
                    while (!GameState.ActiveGame.IsGameOver)
                    {
                        var dummyWrong = new string('9', GameState.ActiveGame.CodeLength);
                        GameState.SubmitActiveGuess(dummyWrong, 0);
                    }
                    if (audioEnabled)
                    {
                        await JS.InvokeVoidAsync("CyberAudio.playLockout");
                    }
                    StateHasChanged();
                });
                break;
            }
        }
    }

    private async Task ToggleAudio()
    {
        audioEnabled = !audioEnabled;
        try
        {
            await JS.InvokeVoidAsync("CyberAudio.toggleSound");
        }
        catch { }
    }

    private void InputDigit(char digit)
    {
        if (GameState.ActiveGame.IsGameOver) return;
        statusFeedback = "";

        if (currentInput.Length < GameState.ActiveGame.CodeLength)
        {
            currentInput += digit;
            if (audioEnabled)
            {
                _ = JS.InvokeVoidAsync("CyberAudio.playKeyPress");
            }
        }
    }

    private void DeleteDigit()
    {
        if (GameState.ActiveGame.IsGameOver) return;
        statusFeedback = "";

        if (currentInput.Length > 0)
        {
            currentInput = currentInput[..^1];
            if (audioEnabled)
            {
                _ = JS.InvokeVoidAsync("CyberAudio.playDelete");
            }
        }
    }

    private async Task SubmitCurrentGuess()
    {
        if (GameState.ActiveGame.IsGameOver) return;

        if (currentInput.Length != GameState.ActiveGame.CodeLength)
        {
            statusFeedback = $"Passcode requires exactly {GameState.ActiveGame.CodeLength} digits.";
            await TriggerShake();
            return;
        }

        try
        {
            if (audioEnabled)
            {
                await JS.InvokeVoidAsync("CyberAudio.playSubmit");
            }

            var attempt = GameState.SubmitActiveGuess(currentInput, secondsRemaining);
            currentInput = "";
            statusFeedback = "";

            if (GameState.ActiveGame.IsSolved)
            {
                if (audioEnabled)
                {
                    await Task.Delay(200);
                    await JS.InvokeVoidAsync("CyberAudio.playAccessGranted");
                }
            }
            else if (GameState.ActiveGame.IsGameOver)
            {
                if (audioEnabled)
                {
                    await Task.Delay(200);
                    await JS.InvokeVoidAsync("CyberAudio.playLockout");
                }
            }
            else
            {
                secondsRemaining = Math.Max(1, secondsRemaining - 3);
                _ = TriggerPenaltyAlert();
            }
        }
        catch (Exception ex)
        {
            statusFeedback = ex.Message;
            await TriggerShake();
        }
    }

    private DigitIntelStatus GetDigitIntel(char digit)
    {
        bool isMisplaced = false;
        bool isTested = false;

        foreach (var attempt in GameState.ActiveGame.Attempts)
        {
            for (int i = 0; i < attempt.GuessString.Length; i++)
            {
                if (attempt.GuessString[i] == digit)
                {
                    isTested = true;
                    if (attempt.Statuses[i] == DigitStatus.Correct)
                    {
                        return DigitIntelStatus.Correct;
                    }
                    if (attempt.Statuses[i] == DigitStatus.Misplaced)
                    {
                        isMisplaced = true;
                    }
                }
            }
        }

        if (isMisplaced) return DigitIntelStatus.Misplaced;
        if (isTested) return DigitIntelStatus.Eliminated;
        return DigitIntelStatus.Untested;
    }

    private string GetKeypadIntelClass(char digit)
    {
        var intel = GetDigitIntel(digit);
        return intel switch
        {
            DigitIntelStatus.Correct => "bg-emerald-500/25 border-emerald-400 text-emerald-300 shadow-[0_0_12px_rgba(16,185,129,0.35)]",
            DigitIntelStatus.Misplaced => "bg-amber-500/25 border-amber-400 text-amber-300 shadow-[0_0_12px_rgba(245,158,11,0.35)]",
            DigitIntelStatus.Eliminated => "bg-black/90 border-white/5 text-slate-600 line-through opacity-40",
            _ => "bg-black/60 hover:bg-rose-500/15 active:bg-rose-500/30 border-rose-500/20 hover:border-rose-400/50 text-white"
        };
    }

    private async Task TriggerPenaltyAlert()
    {
        penaltyFlash = true;
        isShaking = true;
        StateHasChanged();
        await Task.Delay(500);
        penaltyFlash = false;
        isShaking = false;
        StateHasChanged();
    }

    private async Task TriggerShake()
    {
        isShaking = true;
        StateHasChanged();
        await Task.Delay(400);
        isShaking = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (GameState.ActiveGame.IsGameOver) return;

        if (e.Key.Length == 1 && char.IsDigit(e.Key[0]))
        {
            InputDigit(e.Key[0]);
        }
        else if (e.Key == "Backspace")
        {
            DeleteDigit();
        }
        else if (e.Key == "Enter")
        {
            _ = SubmitCurrentGuess();
        }
    }

    private void StartFreshVault()
    {
        currentInput = "";
        statusFeedback = "";
        GameState.StartNewGame();
        ResetTimer();
    }

    private void SwitchClearance(ClearanceLevel level)
    {
        currentInput = "";
        statusFeedback = "";
        GameState.StartNewGame(level);
        ResetTimer();
    }

    public void Dispose()
    {
        GameState.OnChange -= HandleGameStateChange;
        cts?.Cancel();
        cts?.Dispose();
    }
}
