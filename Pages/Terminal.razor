                    </div>

                    <!-- Pro Tip Banner -->
                    <div class="flex items-start gap-2.5 p-3 rounded-xl bg-amber-500/10 border border-amber-500/25 text-xs font-mono text-amber-300">
                        <i class="fa-solid fa-lightbulb text-amber-400 flex-shrink-0 mt-0.5"></i>
                        <span>Pro tip: Start with spread digits like <strong class="text-white">1 2 5 8</strong> to maximise first-attempt information gain and narrow down the passcode faster.</span>
                    </div>

                    <!-- CTA Dismiss Button — writes to localStorage, never shows again -->
                    <button type="button" @onclick="DismissBriefing"
                            class="w-full py-4 rounded-xl font-mono text-sm font-extrabold bg-gradient-to-r from-rose-600 via-red-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white shadow-[0_0_30px_rgba(244,63,94,0.5)] transition-all duration-200 card-lift flex items-center justify-center gap-3 tracking-wide">
                        <i class="fa-solid fa-circle-check text-lg"></i>
                        <span>ACKNOWLEDGED — INITIATE BREACH</span>
                    </button>

                    <p class="text-center text-[10px] font-mono text-slate-500 tracking-wide">
                        This briefing will not appear again after dismissal, Agent <span class="text-rose-400 font-bold">@GameState.CurrentAgent.Codename</span>.
