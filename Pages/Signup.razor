@page "/signup"
@inject GameStateService GameState
@inject NavigationManager Navigation

<PageTitle>Recruit Dossier — VaultCode Step 4: Operative Enrollment</PageTitle>

<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-xl glass-card-accent p-6 sm:p-10 space-y-7 anim-fade-up border border-rose-500/25">
        
        <!-- Mission Phase Indicator -->
        <div class="flex items-center justify-between text-xs font-mono border-b border-rose-500/20 pb-3">
            <span class="text-rose-400 font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-id-card"></i> PHASE 4 // OPERATIVE ENROLLMENT
            </span>
            <span class="text-emerald-400 font-bold">CIRCUIT FINAL STAGE</span>
        </div>

        <!-- Header -->
        <div class="text-center space-y-2">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-rose-500/15 border border-rose-500/40 flex items-center justify-center text-rose-400 text-2xl shadow-[0_0_20px_rgba(244,63,94,0.35)] anim-float">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold font-display text-white">Enroll Agent Dossier</h1>
            <p class="text-xs sm:text-sm text-slate-400">Lock your infiltrator profile into the encrypted persistent registry.</p>
        </div>

        <EditForm Model="signupModel" OnValidSubmit="HandleSignup" class="space-y-5">
            <!-- Name Fields -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">
                        First Name
                    </label>
                    <input type="text" @bind="signupModel.FirstName" placeholder="e.g. Elena" required
                           class="w-full px-4 py-2.5 rounded-xl glass-input text-sm font-sans placeholder:text-slate-600" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">
                        Last Name
                    </label>
                    <input type="text" @bind="signupModel.LastName" placeholder="e.g. Rostova" required
                           class="w-full px-4 py-2.5 rounded-xl glass-input text-sm font-sans placeholder:text-slate-600" />
                </div>
            </div>

            <!-- Codename & Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">
                        <i class="fa-solid fa-terminal text-rose-400 mr-1.5"></i>Hacker Codename
                    </label>
                    <input type="text" @bind="signupModel.Codename" placeholder="e.g. RedValkyrie_09" required
                           class="w-full px-4 py-2.5 rounded-xl glass-input text-sm font-mono placeholder:text-slate-600" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">
                        <i class="fa-solid fa-envelope text-rose-400 mr-1.5"></i>Secure Relay Email
                    </label>
                    <input type="email" @bind="signupModel.Email" placeholder="agent@vaultcode.net" required
                           class="w-full px-4 py-2.5 rounded-xl glass-input text-sm font-sans placeholder:text-slate-600" />
                </div>
            </div>

            <!-- Avatar Selection -->
            <div class="space-y-2">
                <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">
                    <i class="fa-solid fa-id-card-clip text-rose-400 mr-1.5"></i>Primary Operative Avatar
                </label>
                <div class="grid grid-cols-5 gap-2.5">
                    @foreach (var avatar in avatarOptions)
                    {
                        <button type="button" @onclick="() => selectedAvatar = avatar.Icon"
                                class="p-3 rounded-xl border flex flex-col items-center gap-1.5 transition-all duration-200 card-lift @(selectedAvatar == avatar.Icon ? "bg-rose-500/25 border-rose-400 text-rose-300 shadow-[0_0_15px_rgba(244,63,94,0.4)]" : "bg-black/50 border-white/10 text-slate-400 hover:border-white/20")">
                            <i class="fa-solid @avatar.Icon text-xl"></i>
                            <span class="text-[9px] font-mono tracking-tight">@avatar.Label</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Target Clearance Selection -->
            <div class="space-y-2">
                <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">
                    <i class="fa-solid fa-shield-halved text-rose-400 mr-1.5"></i>Clearance Rank
                </label>
                <div class="grid grid-cols-2 gap-3">
                    <button type="button" @onclick="() => selectedClearance = ClearanceLevel.Operative"
                            class="p-3.5 rounded-xl border flex items-center justify-between transition-all duration-200 @(selectedClearance == ClearanceLevel.Operative ? "bg-rose-500/20 border-rose-400 text-white shadow-[0_0_15px_rgba(244,63,94,0.3)]" : "bg-black/50 border-white/10 text-slate-400")">
                        <div class="text-left">
                            <div class="text-sm font-bold font-display">Operative</div>
                            <span class="text-[11px] text-slate-400">4-Digit code // 30s</span>
                        </div>
                        <i class="fa-solid fa-shield text-rose-400 text-lg"></i>
                    </button>

                    <button type="button" @onclick="() => selectedClearance = ClearanceLevel.Mastermind"
                            class="p-3.5 rounded-xl border flex items-center justify-between transition-all duration-200 @(selectedClearance == ClearanceLevel.Mastermind ? "bg-amber-500/20 border-amber-400 text-white shadow-[0_0_15px_rgba(245,158,11,0.3)]" : "bg-black/50 border-white/10 text-slate-400")">
                        <div class="text-left">
                            <div class="text-sm font-bold font-display">Mastermind</div>
                            <span class="text-[11px] text-slate-400">5-Digit code // 20s Hard</span>
                        </div>
                        <i class="fa-solid fa-skull text-amber-400 text-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Password & Confirm Password -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">
                        Neural Password
                    </label>
                    <input type="password" @bind="signupModel.Password" placeholder="••••••••" required
                           class="w-full px-4 py-2.5 rounded-xl glass-input text-sm font-mono placeholder:text-slate-600" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">
                        Confirm Password
                    </label>
                    <input type="password" @bind="signupModel.ConfirmPassword" placeholder="••••••••" required
                           class="w-full px-4 py-2.5 rounded-xl glass-input text-sm font-mono placeholder:text-slate-600" />
                </div>
            </div>

            <!-- Error Banner -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3 rounded-xl bg-rose-500/15 border border-rose-500/40 text-rose-300 text-xs flex items-center gap-2 anim-fade-up">
                    <i class="fa-solid fa-triangle-exclamation text-sm"></i>
                    <span>@errorMessage</span>
                </div>
            }

            <!-- Submit Button: Completes enrollment and loops back to home or terminal -->
            <button type="submit" disabled="@isSubmitting"
                    class="w-full py-3.5 rounded-xl font-mono text-sm font-bold bg-gradient-to-r from-rose-600 via-red-600 to-amber-600 hover:from-rose-500 hover:to-amber-500 text-white shadow-[0_0_20px_rgba(244,63,94,0.4)] transition-all duration-200 card-lift flex items-center justify-center gap-2 disabled:opacity-50">
                @if (isSubmitting)
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <span>ENCRYPTING AGENT DOSSIER...</span>
                }
                else
                {
                    <i class="fa-solid fa-user-check"></i>
                    <span>CONFIRM DOSSIER & COMPLETE CIRCUIT</span>
                }
            </button>
        </EditForm>

        <!-- Back to Start link -->
        <div class="pt-2 border-t border-rose-500/20 text-center text-xs text-slate-400">
            <span>Circuit complete?</span>
            <a href="" class="text-rose-400 font-semibold hover:underline ml-1.5">Return to Step 1: Home Briefing</a>
        </div>
    </div>
</div>

@code {
    private SignupDto signupModel = new();
    private ClearanceLevel selectedClearance = ClearanceLevel.Operative;
    private string selectedAvatar = "fa-user-ninja";
    private string errorMessage = string.Empty;
    private bool isSubmitting = false;

    private readonly List<(string Icon, string Label)> avatarOptions = new()
    {
        ("fa-user-ninja", "Ninja"),
        ("fa-user-secret", "Ghost"),
        ("fa-robot", "Synth"),
        ("fa-terminal", "Hacker"),
        ("fa-skull-crossbones", "Cipher")
    };

    private async Task HandleSignup()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(signupModel.Codename) || signupModel.Codename.Trim().Length < 3)
        {
            errorMessage = "Agent codename must be at least 3 characters.";
            return;
        }

        if (string.IsNullOrWhiteSpace(signupModel.Password) || signupModel.Password.Length < 4)
        {
            errorMessage = "Password must be at least 4 characters long.";
            return;
        }

        if (signupModel.Password != signupModel.ConfirmPassword)
        {
            errorMessage = "Neural password and confirmation do not match.";
            return;
        }

        isSubmitting = true;
        StateHasChanged();
        await Task.Delay(500);

        GameState.UpdateAgent(
            signupModel.Codename.Trim(),
            selectedClearance,
            selectedAvatar,
            signupModel.FirstName.Trim(),
            signupModel.LastName.Trim(),
            signupModel.Email.Trim()
        );

        Navigation.NavigateTo("terminal");
    }

    public class SignupDto
    {
        public string FirstName { get; set; } = "Red";
        public string LastName { get; set; } = "Valkyrie";
        public string Codename { get; set; } = "RedValkyrie_09";
        public string Email { get; set; } = "valkyrie@netrunner.org";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
